# Ollama (host.docker.internal supaya container bisa akses Ollama yang jalan di host)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# WhatsApp
WHITELIST_GROUP_IDS=xxxxx@g.us,yyyyy@g.us

# Scheduler
AUTO_RECAP_ENABLED=false
AUTO_RECAP_CRON=0 21 * * *

# Mode Asisten
ASSISTANT_TRIGGER_WORD=@kacan
ASSISTANT_TRIGGER_PREFIXES=!ai,!tanya
CONVERSATION_MEMORY_LIMIT=20
ASSISTANT_RATE_LIMIT_SECONDS=5

# Storage
DB_PATH=./data/chat_history.db
PRUNE_DAYS=30
