# Ollama (host.docker.internal supaya container bisa akses Ollama yang jalan di host)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Suhu model Ollama (rendah = jawaban lebih fokus/tidak nyasar, 0.6 default)
OLLAMA_TEMPERATURE=0.6
# Batas token jawaban Ollama (rekap otomatis pakai 2048)
OLLAMA_MAX_TOKENS=1024
# Waktu tunggu Ollama untuk menjawab (2 menit). Lewat dari ini → fallback ke cloud.
OLLAMA_TIMEOUT_MS=120000

# AI routing & fallback (Ollama lokal + multi-provider cloud, auto-pindah kalau kuota habis)
# Urutan provider cloud (koma). Hanya yang punya API key yang ikut dicoba.
# Setiap gagal (terutama 429/402/403 kuota/limit gratis habis) → otomatis pindah ke provider berikutnya.
AI_CLOUD_PROVIDERS=gemini,groq,openrouter,anthropic,sumopod
# Cooldown (ms) sebelum provider yang kena limit dicoba lagi
AI_CLOUD_COOLDOWN_MS=60000

# Gemini (free tier) - otomatis dipakai paling awal
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=1024

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024

# OpenRouter (model gratis pakai akhiran :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MAX_TOKENS=1024

# Anthropic / SumoPod (opsional, dipakai kalau yang gratis semua gagal)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
SUMOPOD_API_KEY=
SUMOPOD_MODEL=claude-sonnet-4-6
SUMOPOD_MAX_TOKENS=1024
# Batas waktu panggilan cloud (per provider). Total Ollama 2 menit + cloud ≈ 3-4 menit.
AI_TIMEOUT_MS=60000
# Batas panjang konteks (chars) yang dikirim ke model. Lebih pendek = jawaban lebih fokus/tidak campur.
AI_CONTEXT_MAX_CHARS=8000
AI_DEFAULT_LEVEL=standard

# WhatsApp ('*' = semua group; atau daftar ID group, pisahkan koma)
WHITELIST_GROUP_IDS=xxxxx@g.us,yyyyy@g.us

# Scheduler
AUTO_RECAP_ENABLED=false
AUTO_RECAP_CRON=0 21 * * *

# Mode Asisten
ASSISTANT_TRIGGER_WORD=@kacan
ASSISTANT_TRIGGER_PREFIXES=!ai,!tanya
CONVERSATION_MEMORY_LIMIT=20
PERSONAL_MEMORY_LIMIT=20
ASSISTANT_RATE_LIMIT_SECONDS=5

# Storage
DB_PATH=./data/chat_history.db
PRUNE_DAYS=30

# Akses & Admin
# ADMIN_NUMBERS=6281234567890,6289876543210  (kosong = belum ada admin)
# FAMILY_MEMBERS=6281234567890               (kosong = semua orang di group whitelist dianggap anggota keluarga)
ADMIN_NUMBERS=
FAMILY_MEMBERS=

# Health check (notifikasi ke admin saat koneksi turun)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MIN=5

# Monitoring baterai server (laptop): alert ke admin saat baterai <= threshold,
# diulang maks 5x tiap 2 menit sampai admin membalas pesan alert.
# Catatan: butuh mount /sys/class/power_supply di docker-compose.yml.
SERVER_BATTERY_ALERT_ENABLED=true
SERVER_BATTERY_ALERT_THRESHOLD=20
SERVER_BATTERY_ALERT_MAX=5
SERVER_BATTERY_ALERT_INTERVAL_MIN=2
SERVER_BATTERY_POLL_SEC=60

# Logging (rotasi harian)
LOG_DIR=./logs

# Info cepat (opsional)
WEATHER_LAT=-6.2000
WEATHER_LON=106.8166
PRAYER_CITY=Jakarta

# Nama bot untuk kepribadian
BOT_NAME=Kacan
